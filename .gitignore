/Meta/
# dev/ is scratch and stays untracked, EXCEPT dev/simstudy/, which holds the
# simulation-validation plan and runner. Note the pattern: git cannot re-include
# a file whose parent directory is excluded, so this must exclude dev/'s
# *contents* (/dev/*) rather than the directory itself, then re-include the
# subdirectory. Study output stays ignored -- it is large and regenerable.
/dev/*
!/dev/simstudy/
/dev/simstudy/results/
