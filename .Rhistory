b_betatheta, B_betatheta)
},{
theta <- computeTheta(X_theta, beta_theta)
},{
list_pq <- sample_pq_cpp(c_imk, y_NA, w, idx_p_k, idx_w_k, maxP, a_p, b_p, a_q, b_q)
p <- list_pq$p
q <- list_pq$q
},{
theta0 <- sample_theta0(z, w, idx_z_w, a_theta0, b_theta0)
}, times = 50)
