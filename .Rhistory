X <- matrix(rnorm(100 * 5), 100, 5)
apply(X, 2, sd)
fast_sd <- function(X){
n <- nrow(X)
result <- sqrt(colSums((t(t(X) - colMeans(X)))^2) / (n - 1))
result
}
fast_sd(X)
apply(logistic(X), 2, sd)
fast_sd(logistic(X))
